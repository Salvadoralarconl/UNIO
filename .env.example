# Copy to .env and supply a local database password. Do not commit .env.
POSTGRES_PASSWORD=
AI_PROVIDER=OpenAI
# The launcher inherits OPENAI_API_KEY from Windows. Leave this empty here.
OPENAI_API_KEY=
GENERATION_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
MIN_SIMILARITY=0.45
# Private Ubuntu Ollama server; leave blank until its LAN URL is known.
OLLAMA_BASE_URL=
OLLAMA_GENERATION_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_EMBEDDING_DIMENSIONS=768
RETRIEVAL_MAX_DOCUMENTS=3
RETRIEVAL_PASSAGES_PER_DOCUMENT=2
RETRIEVAL_SCORE_WINDOW=0.20

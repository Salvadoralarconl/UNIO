FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY backend/Clary.Api/Clary.Api.csproj backend/Clary.Api/
RUN dotnet restore backend/Clary.Api/Clary.Api.csproj
COPY backend/Clary.Api/ backend/Clary.Api/
COPY database/ database/
COPY samples/ samples/
RUN dotnet publish backend/Clary.Api/Clary.Api.csproj -c Release -o /out --no-restore
FROM mcr.microsoft.com/dotnet/aspnet:10.0
USER root
RUN apt-get update && apt-get install -y --no-install-recommends curl openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/ ./
COPY deploy/init-tls.sh /usr/local/bin/init-unio-tls
RUN chmod 755 /usr/local/bin/init-unio-tls \
    && mkdir -p /app/uploads /app/keys /app/private/Brie \
    && chown -R app:app /app/uploads /app/keys /app/private \
    && chmod 700 /app/keys /app/private /app/private/Brie
ENV XDG_DATA_HOME=/app/private
USER app
EXPOSE 8443
ENTRYPOINT ["dotnet", "Clary.Api.dll"]
